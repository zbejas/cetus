{
  "name": "cetus",
  "version": "0.1.6",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun run --hot apps/server/src/index.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "build": "bun run build:web",
    "start": "NODE_ENV=production bun apps/server/src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test apps packages",
    "seed": "bun apps/server/src/seed.ts",
    "dev:all": "concurrently -k -n api,web -c cyan,magenta \"bun run dev\" \"bun run dev:web\"",
    "worker": "bun apps/server/src/worker.ts",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "test:visual:update": "playwright test --config playwright.visual.config.ts --update-snapshots"
  },
  "dependencies": {
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@elysiajs/openapi": "1.4.17",
    "@elysiajs/static": "^1.4.12",
    "@tanstack/react-query": "^5.108.4",
    "@tanstack/react-router": "^1.170.46",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "better-auth": "^1.7.27",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "drizzle-orm": "^0.45.4",
    "elysia": "^1.4.32",
    "lucide-react": "^1.78.0",
    "motion": "^14.14.0",
    "nodemailer": "^10.6.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "latest",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
